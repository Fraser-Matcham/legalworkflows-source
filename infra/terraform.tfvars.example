# Copy to terraform.tfvars (gitignored). Every value has a sensible default in
# variables.tf; this file exists to make an override explicit and reviewable
# rather than typed on the command line. Never put a secret in it — secret
# values reach the service through Secrets Manager (the `secrets` module), not
# through Terraform variables.
project     = "legalworkflows"
environment = "production"
aws_region  = "eu-west-2"
domain_name = "legalworkflows.co.uk"

# Required, no default: the Hosted zone ID from Stage 3, Task 7. Terraform
# imports the zone the operator created rather than making a second one.
route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Required, no default: the Supabase project from Stage 2, Task 2. Both values
# are public by design (the browser bundle carries them); the *secret* key is
# not, and goes in the operator secret — see infra/modules/secrets/README.md.
supabase_url             = "https://abcdefghijkl.supabase.co"
supabase_publishable_key = "sb_publishable_..."

# The workflow catalogue the release job syncs. Point at your own fork, and pin
# a commit SHA for a reproducible release.
# The workflow catalogue. The release pipeline syncs it from the new image and
# fails the deploy if it cannot — so if you point this at a repository the
# deployment cannot read, every release stops there. Set it to "" if you do not
# want a catalogue: the sync is then skipped and the release continues.
workflows_repository = "Open-Legal-Products/mike-workflows"
workflows_ref        = "main"

# Optional operator secrets to inject once they have been written:
# backend_extra_secret_keys = ["ERROR_TRACKING_DSN", "MIKE_WORKFLOWS_GITHUB_TOKEN"]

# --- Stage 5: the self-hosted platform (docs/delivery-plan/v2/plan.md) ---------
# Nothing below is created until platform_enabled is true, and that waits on
# Stage 5, Task 1 (the running cost). platform_serves_backend is the cutover
# switch and stays false until the rehearsal has passed
# (docs/runbooks/platform-cutover.md); flipping it back is the rollback.
# platform_enabled                 = true
# database_instance_class          = "db.t4g.small"
# database_multi_az                = false
# database_backup_retention_days   = 35
# gotrue_google_oauth_enabled      = false   # true once Stage 5, Task 3 has written the secret
# platform_serves_backend          = false

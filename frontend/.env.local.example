# Server-only upstream used by the same-origin /api gateway.
API_BASE_URL=http://localhost:3001

# Canonical public origin of this deployment. Used as metadataBase in
# app/layout.tsx, so Open Graph image URLs in link previews resolve against it.
# Leave unset locally (defaults to http://localhost:3000); set it in staging and
# production or shared links render with broken preview images.
NEXT_PUBLIC_APP_URL=http://localhost:3000
